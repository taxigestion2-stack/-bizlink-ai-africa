# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Jamais exposée au client. Utilisée uniquement dans lib/supabase/server.ts (createServiceRoleClient)
# pour les webhooks, le cron, et quelques Server Actions administratives.
SUPABASE_SERVICE_ROLE_KEY=

# URL publique du site (utilisée pour les redirections OAuth, e-mails, webhooks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# IA (Chatbot Business AI) — Groq Cloud par défaut (gratuit, sans carte bancaire)
# Créer une clé sur https://console.groq.com → API Keys
AI_API_KEY=
AI_API_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile

# Cron (protège /api/cron/inventory)
CRON_SECRET=

# Fournisseur de paiement de référence (voir lib/payments/providers/manual-provider.ts)
MANUAL_PAYMENT_WEBHOOK_SECRET=

# PawaPay (Mobile Money Afrique) — voir lib/payments/providers/pawapay-provider.ts
# Sandbox : https://api.sandbox.pawapay.io (par défaut) — Production : https://api.pawapay.io
PAWAPAY_API_TOKEN=
PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io
